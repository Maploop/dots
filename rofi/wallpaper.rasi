configuration {
    show-icons: true;
    display-dmenu: "Wallpapers:";
    //matching: regex;

    kb-move-char-forward: "Right";
    kb-move-char-back: "Left";

    fixed-height: true;
    animation: false;
}


/* ── Even Darker Nord Palette ────────────────────────────────────────── */

* {
    /* Backgrounds */
    bg0:     #080A0E;
    bg1:     #0D1117;
    bg2:     #11151C;
    bg3:     #343D4B;

    /* Foreground */
    fg0:     #D8DEE9;
    fg1:     #AAB4C3;
    fg2:     #667085;

    /* Nord accents */
    red:     #BF616A;
    green:   #A3BE8C;
    yellow:  #EBCB8B;
    blue:    #5E81AC;
    magenta: #B48EAD;
    cyan:    #88C0D0;
    purple:  #B48EAD;
    teal:    #8FBCBB;

    /* Semantic colors */
    accent:  @blue;
    urgent:  @yellow;

    background-color: transparent;
    text-color: @fg0;
}


/* ── Window ───────────────────────────────────────────────────────────── */

window {
    width: 950px;
    height: 400px;

    background-color: @bg0;

    border: 1px;
    border-color: @bg3;

    border-radius: 0px;

    padding: 0px;
}


/* ── Main box ─────────────────────────────────────────────────────────── */

mainbox {
    background-color: transparent;

    children: [
        inputbar,
        listview
    ];

    spacing: 0px;
    padding: 12px;
}


/* ── Input bar ────────────────────────────────────────────────────────── */

inputbar {
    background-color: @bg2;

    padding: 1px 10px;

    margin: 0px 0px 10px 0px;

    children: [
        prompt,
        entry
    ];

    spacing: 6px;
}

prompt {
    background-color: transparent;

    text-color: @accent;

    font: "Iosevka Nerd Font 20";
}

entry {
    background-color: transparent;

    text-color: @fg0;

    placeholder: "Search wallpapers...";
    placeholder-color: @fg2;

    font: "Iosevka Nerd Font 20";

    cursor: text;
}


/* ── Wallpaper list ──────────────────────────────────────────────────── */

listview {
    background-color: transparent;

    columns: 3;
    lines: 3;

    spacing: 4px;

    fixed-height: false;
    fixed-columns: true;

    scrollbar: false;
}


/* ── Wallpaper elements ──────────────────────────────────────────────── */

element {
    background-color: transparent;

    text-color: @fg0;

    border: 0px;
    border-radius: 0px;

    padding: 8px;

    spacing: 8px;

    orientation: vertical;

    cursor: pointer;
}


/* ── Normal ───────────────────────────────────────────────────────────── */

element normal.normal {
    background-color: transparent;
    text-color: @fg0;
}


/* ── Alternate rows ──────────────────────────────────────────────────── */

element alternate.normal {
    background-color: transparent;
    text-color: @fg0;
}


/* ── Selected ─────────────────────────────────────────────────────────── */

element selected.normal {
    background-color: @bg2;

    text-color: @fg0;

    border: 1px;
    border-color: @accent;
}


/* ── Thumbnail ────────────────────────────────────────────────────────── */

element-icon {
    background-color: transparent;

    size: 270px;

    cursor: inherit;
}


/* ── Filename ─────────────────────────────────────────────────────────── */

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;

    horizontal-align: 0.5;
    vertical-align: 0.5;

    font: "Iosevka Nerd Font 10";

    //ellipsize: end;
}


/* ── Scrollbar ────────────────────────────────────────────────────────── */

scrollbar {
    width: 4px;

    handle-width: 4px;

    background-color: @bg2;
    handle-color: @accent;

    border-radius: 0px;
}
