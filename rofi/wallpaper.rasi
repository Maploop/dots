configuration {
    show-icons: true;
    display-dmenu: "Wallpapers:";
    //matching: regex;

    kb-move-char-forward: "Right";
    kb-move-char-back: "Left";

    fixed-height: true;
    animation: false;
}


 /* ── very dark tokyo night palette ───────────────────────────────────── */

* {
    /* backgrounds */
    bg0:     #08090d;   /* main background */
    bg1:     #0d1017;   /* elevated background */
    bg2:     #11131a;   /* surface */
    bg3:     #292d3e;   /* border / selected surface */

    /* foreground */
    fg0:     #c0caf5;   /* primary text */
    fg1:     #7a819b;   /* secondary text */
    fg2:     #4f5570;   /* muted text */

    /* tokyo night accents */
    red:     #f7768e;
    green:   #9ece6a;
    yellow:  #e0af68;
    blue:    #7aa2f7;
    magenta: #bb9af7;
    cyan:    #7dcfff;
    purple:  #bb9af7;
    teal:    #73daca;

    /* semantic colors */
    accent:  @blue;
    urgent:  @yellow;

    background-color: transparent;
    text-color:       @fg0;
}

/* ── Window ───────────────────────────────────────────────────────────── */

window {
    width: 950px;
    height: 400px;

    background-color: @bg0;

    border: 1px;
    border-color: @bg3;

    border-radius: 0px;

    padding: 0px;
}


/* ── Main box ─────────────────────────────────────────────────────────── */

mainbox {
    background-color: transparent;

    children: [
        inputbar,
        listview
    ];

    spacing: 0px;
    padding: 12px;
}


/* ── Input bar ────────────────────────────────────────────────────────── */

inputbar {
    background-color: @bg2;

    padding: 1px 10px;

    margin: 0px 0px 10px 0px;

    children: [
        prompt,
        entry
    ];

    spacing: 6px;
}

prompt {
    background-color: transparent;

    text-color: @accent;

    font: "Iosevka Nerd Font 20";
}

entry {
    background-color: transparent;

    text-color: @fg0;

    placeholder: "Search wallpapers...";
    placeholder-color: @fg2;

    font: "Iosevka Nerd Font 20";

    cursor: text;
}


/* ── Wallpaper list ──────────────────────────────────────────────────── */

listview {
    background-color: transparent;

    columns: 3;
    lines: 3;

    spacing: 4px;

    fixed-height: false;
    fixed-columns: true;

    scrollbar: false;
}


/* ── Wallpaper elements ──────────────────────────────────────────────── */

element {
    background-color: transparent;

    text-color: @fg0;

    border: 0px;
    border-radius: 0px;

    padding: 8px;

    spacing: 8px;

    orientation: vertical;

    cursor: pointer;
}


/* ── Normal ───────────────────────────────────────────────────────────── */

element normal.normal {
    background-color: transparent;
    text-color: @fg0;
}


/* ── Alternate rows ──────────────────────────────────────────────────── */

element alternate.normal {
    background-color: transparent;
    text-color: @fg0;
}


/* ── Selected ─────────────────────────────────────────────────────────── */

element selected.normal {
    background-color: @bg2;

    text-color: @fg0;

    border: 1px;
    border-color: @accent;
}


/* ── Thumbnail ────────────────────────────────────────────────────────── */

element-icon {
    background-color: transparent;

    size: 270px;

    cursor: inherit;
}


/* ── Filename ─────────────────────────────────────────────────────────── */

element-text {
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;

    horizontal-align: 0.5;
    vertical-align: 0.5;

    font: "Iosevka Nerd Font 10";

    //ellipsize: end;
}


/* ── Scrollbar ────────────────────────────────────────────────────────── */

scrollbar {
    width: 4px;

    handle-width: 4px;

    background-color: @bg2;
    handle-color: @accent;

    border-radius: 0px;
}
