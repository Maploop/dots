configuration {
    modes:              "drun";
    sorting-method:     "normal";
    show-icons:         true;
    terminal:           "kitty";
    editor:             "micro";
    matching:           "regex";
    drun-match-fields:  "name";

    /* display-run:        "Window:";
    display-ssh:        " SSH:";
    display-drun:       "󰀻 Apps:";
    display-emoji:      "󱃞 Emoji";
    */

    kb-move-char-forward: "Right";
    kb-move-char-back:    "Left";
    kb-mode-next:         "Alt+Right";
    kb-mode-previous:     "Alt+Left";

    window-format:      "{n} {t}";
    drun-display-format: "{name}";
    fixed-height:       true;
}

@theme "storm"

 /* ── very dark tokyo night palette ───────────────────────────────────── */

* {
    /* backgrounds */
    bg0:     #08090d;   /* main background */
    bg1:     #0d1017;   /* elevated background */
    bg2:     #11131a;   /* surface */
    bg3:     #292d3e;   /* border / selected surface */

    /* foreground */
    fg0:     #c0caf5;   /* primary text */
    fg1:     #7a819b;   /* secondary text */
    fg2:     #4f5570;   /* muted text */

    /* tokyo night accents */
    red:     #f7768e;
    green:   #9ece6a;
    yellow:  #e0af68;
    blue:    #7aa2f7;
    magenta: #bb9af7;
    cyan:    #7dcfff;
    purple:  #bb9af7;
    teal:    #73daca;

    /* semantic colors */
    accent:  @blue;
    urgent:  @yellow;

    background-color: transparent;
    text-color:       @fg0;
}


/* ── Window ───────────────────────────────────────────────────────────── */

window {
    width:            500px;
    background-color: @bg0;
    border:           1px;
    border-color:     @bg3;
    border-radius:    0px;
    padding:          0;
}


/* ── Main box ─────────────────────────────────────────────────────────── */

mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          0;
    padding:          12px;
}


/* ── Input bar ────────────────────────────────────────────────────────── */

inputbar {
    background-color: @bg2;
    padding:          1px 10px;
    margin:           0 0 10px 0;
    children:         [ prompt, entry ];
    spacing:          6px;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "Iosevka Nerd Font 20";
}

entry {
    background-color: transparent;
    text-color:       @fg0;
    placeholder:      "";
    placeholder-color: @fg2;
    font:             "Iosevka Nerd Font 20";
    cursor:           text;
}


/* ── Buttons ──────────────────────────────────────────────────────────── */

button {
    background-color: @bg2;
    text-color:       @fg0;
    border-radius:    1px;
    cursor:           pointer;
}

button selected {
    background-color: @accent;
    text-color:       @bg0;
}


/* ── List view ────────────────────────────────────────────────────────── */

listview {
    background-color: transparent;
    columns:          1;
    lines:            5;
    spacing:          4px;
    fixed-height:     false;
}

scrollbar {
    width:            4px;
    handle-width:     4px;
    background-color: @bg2;
    handle-color:     @accent;
    border-radius:    0px;
}


/* ── List elements ───────────────────────────────────────────────────── */

element {
    background-color: transparent;
    text-color:       @fg0;
    border-radius:    0px;
    padding:          8px 10px;
    spacing:          8px;
    orientation:      horizontal;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg0;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element normal.active {
    background-color: transparent;
    text-color:       @cyan;
}

element selected.normal {
    background-color: @bg3;
    text-color:       @fg0;
    border-color:     @accent;
}

element selected.urgent {
    background-color: @bg3;
    text-color:       @urgent;
    border-color:     @urgent;
}

element selected.active {
    background-color: @bg3;
    text-color:       @cyan;
    border-color:     @cyan;
}


/* ── Icons ────────────────────────────────────────────────────────────── */

element-icon {
    background-color: transparent;
    size:             24px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    font:             "Iosevka Nerd Font 20";
}


/* ── Message ──────────────────────────────────────────────────────────── */

message {
    background-color: @bg2;
    border-radius:    0px;
    padding:          8px 12px;
    margin:           0 0 10px 0;
}

textbox {
    background-color: transparent;
    text-color:       @fg2;
    font:             "Iosevka Nerd Font 20";
}
