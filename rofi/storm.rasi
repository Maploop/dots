* {
    /* backgrounds */
    bg0:     #08090d;   /* main background */
    bg1:     #0d1017;   /* elevated background */
    bg2:     #11131a;   /* surface */
    bg3:     #292d3e;   /* border / selected surface */

    /* foreground */
    fg0:     #c0caf5;   /* primary text */
    fg1:     #7a819b;   /* secondary text */
    fg2:     #4f5570;   /* muted text */

    /* tokyo night accents */
    red:     #f7768e;
    green:   #9ece6a;
    yellow:  #e0af68;
    blue:    #7aa2f7;
    magenta: #bb9af7;
    cyan:    #7dcfff;
    purple:  #bb9af7;
    teal:    #73daca;

    /* semantic colors */
    accent:  @blue;
    urgent:  @yellow;

    background-color: transparent;
    text-color:       @fg0;
}
